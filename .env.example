# The app always binds to 127.0.0.1.
MOUSELINE_LOCAL_PORT=8765

# Optional reverse-proxy mount and exact accepted Host values.
MOUSELINE_ROOT_PATH=
MOUSELINE_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional local room labels and rooms that automatically become breeding pairs.
MOUSELINE_ROOM_ALIASES_JSON='{"ROOM-A":"Regular Cycle room","ROOM-B":"Reverse Cycle room","ROOM-C":"Breeding Core"}'
MOUSELINE_BREEDING_ROOMS=ROOM-C,Breeding Core

# Durable local database. The data directory is excluded from Git.
# MOUSELINE_DATABASE_PATH="/absolute/path/to/mouseline.db"

# Optional initial data sources. They are read only when the database is empty.
# MOUSELINE_SEED_CSV_PATH="/path/to/cage-cards.csv"
# MOUSELINE_SEED_XLSX_PATH="/path/to/mouse-line.xlsx"
MOUSELINE_SEED_ON_EMPTY=true

MOUSELINE_DOCS_ENABLED=false
MOUSELINE_LOG_LEVEL=info
